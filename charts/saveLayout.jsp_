<%@page import="org.json.simple.*"%>
<%@page import="java.util.*"%>
<%@page import="java.sql.DriverManager"%>
<%@page import="java.sql.ResultSet"%>
<%@page import="java.sql.PreparedStatement"%>
<%@page import="java.sql.Connection"%>
<%@page import="java.sql.SQLException"%>
<%@page import="java.text.SimpleDateFormat"%>
<%@page import="java.util.ArrayList"%>
<%@page import="java.util.regex.Matcher"%>
<%@page import="java.util.regex.Pattern"%>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%

	request.setCharacterEncoding("UTF-8");
	
	String userId = request.getParameter("userId");
	String menuId = request.getParameter("menuId");
	String saveData = request.getParameter("saveData");

	Connection conn = null;
	String url = "jdbc:oracle:thin:@172.16.79.101:1521:SCM";
	String user = "mias";
	String password = "picm#ias2";
	String driver = "oracle.jdbc.driver.OracleDriver";
	PreparedStatement pstmt = null;
		
	try{		
        Class.forName(driver);
        conn = DriverManager.getConnection(url, user, password);
		String inSymbol = "";

		String wSql =	"MERGE INTO TEST_LAYOUT t " +
						"USING (SELECT ? AS USER_ID, ? AS MENU_ID, ? AS CHART_DATA FROM DUAL) s " +
						"ON (t.USER_ID = s.USER_ID AND t.MENU_ID = s.MENU_ID) " +
						"WHEN MATCHED THEN " +
						"    UPDATE SET t.CHART_DATA = s.CHART_DATA " +
						"WHEN NOT MATCHED THEN " +
						"    INSERT (USER_ID, MENU_ID, CHART_DATA) " +
						"    VALUES (s.USER_ID, s.MENU_ID, s.CHART_DATA)";
		
        pstmt = conn.prepareStatement(wSql);
		pstmt.setString(1, userId);
		pstmt.setString(2, menuId);
		pstmt.setString(3, saveData);
        
		int rowCnt = pstmt.executeUpdate();
        
		pstmt.close();
        conn.close();
		
		if(rowCnt > 0) {
			out.println("성공적으로 저장되었습니다.");
		}else {
			out.println("저장에 실패하였습니다.");
		}
		
    }catch(Exception e){
		out.println("저장에 실패하였습니다.");
    }finally{
        try{
            if(pstmt != null)   pstmt.close();
            if(conn != null) conn.close();
        }catch(Exception ex) {
            out.println("저장에 실패하였습니다.");
        }
    }
	
%>
